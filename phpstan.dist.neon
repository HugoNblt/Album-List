parameters:
    level: 6
    paths:
        - src
        - tests
    excludePaths:
        - tests/bootstrap.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        # Les entités générées par make:entity déclarent leurs propriétés nullables (?string) même pour
        # des colonnes NOT NULL : c'est voulu (entité vide avant hydratation par le formulaire).
        allowNullablePropertyForRequiredField: true

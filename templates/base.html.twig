<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% if app.user %}
            <meta name="csrf-like" content="{{ csrf_token('review_like') }}">
        {% endif %}
        <title>
            {% block title %}Album List
            {% endblock %}
        </title>
        {% block stylesheets %}
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
            <link href="{{ asset('css/styles.css') }}" type="text/css" rel="stylesheet">
        {% endblock %}
    </head>
    <body>
        <a href="#main" class="skip-link">Aller au contenu</a>
        {% block header %}
            {% set route = app.request.attributes.get('_route') %}
            {% set onOwnProfile = app.user and route == 'app_profile_show' and app.request.attributes.get('username') == app.user.username %}
            <header class="site-header">
                <div class="container site-header__inner">
                    <a href="{{ path('app_home') }}" class="logo">Album<span>/</span>List</a>

                    <nav class="site-nav" aria-label="Navigation principale">
                        <ul>
                            <li><a href="{{ path('app_home') }}" class="{{ route == 'app_home' ? 'is-active' }}">Le fil</a></li>
                            {% if app.user %}
                                <li><a href="{{ path('app_profile') }}" class="{{ onOwnProfile or route == 'app_profile_edit' ? 'is-active' }}">Mon profil</a></li>
                                <li class="site-nav__user">{{ app.user.username }}</li>
                                <li class="site-nav__push"><a href="{{ logout_path() }}">Déconnexion</a></li>
                            {% else %}
                                <li><a href="{{ path('app_login') }}" class="{{ route == 'app_login' ? 'is-active' }}">Connexion</a></li>
                                {% if registration_enabled %}
                                    <li><a href="{{ path('app_register') }}" class="{{ route == 'app_register' ? 'is-active' }}">Inscription</a></li>
                                {% endif %}
                            {% endif %}
                        </ul>
                    </nav>

                    {% if app.user %}
                        {# Bouton qui déclenche la modale de création #}
                        <button type="button" class="btn btn--light site-header__cta" id="open-new-review-modal">+ Critique</button>
                    {% endif %}
                </div>
            </header>
        {% endblock %}

        <main id="main" tabindex="-1">
            {% for message in app.flashes('success') %}
                <div class="container">
                    <div class="flash-message" role="status">{{ message }}</div>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="container">
                    <div class="flash-message flash-message--error" role="alert">{{ message }}</div>
                </div>
            {% endfor %}
            {% block body %}{% endblock %}
        </main>

        <!-- Modale unique native HTML5 -->
        <dialog id="review-modal" class="app-modal app-modal--wide" aria-labelledby="modal-title">
            <div class="modal-header">
                <h3 id="modal-title">Nouvelle critique</h3>
                <button type="button" class="modal-close-btn" data-close-dialog="review-modal" aria-label="Fermer">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>
            <div id="modal-body"></div>
        </dialog>

        {# Choix de la plateforme d'écoute (liens complétés par le JS) #}
        <dialog id="listen-modal" class="app-modal" aria-labelledby="listen-title">
            <div class="modal-header">
                <h2 id="listen-title">Écouter sur…</h2>
                <button type="button" class="modal-close-btn" data-close-dialog="listen-modal" aria-label="Fermer">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <p class="listen-album">
                    <strong class="listen-album__title"></strong>
                    <span class="listen-album__artist"></span>
                </p>
                <ul class="listen-list">
                    {% for platform in [
                        { key: 'spotify', name: 'Spotify' },
                        { key: 'apple', name: 'Apple Music' },
                        { key: 'deezer', name: 'Deezer' },
                        { key: 'youtube', name: 'YouTube Music' },
                        { key: 'tidal', name: 'Tidal' },
                        { key: 'amazon', name: 'Amazon Music' },
                        { key: 'soundcloud', name: 'SoundCloud' }
                    ] %}
                        <li>
                            <a href="#" class="listen-link" data-platform="{{ platform.key }}" target="_blank" rel="noopener noreferrer">
                                {{ platform.name }}<span aria-hidden="true">↗</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                <p class="listen-note eyebrow">Hors Spotify, le lien ouvre une recherche de l'album sur la plateforme.</p>
            </div>
        </dialog>

        {# Pop-up « bêta fermée » : affichée à la première visite tant que les inscriptions sont fermées #}
        {% if not registration_enabled %}
            <dialog id="beta-modal" class="app-modal" aria-labelledby="beta-title" data-beta-notice>
                <div class="modal-header">
                    <h2 id="beta-title">Bêta fermée</h2>
                    <button type="button" class="modal-close-btn" data-close-dialog="beta-modal" aria-label="Fermer">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="beta-notice__lead">Album/List est en phase de test.</p>
                    <ul class="beta-notice__list">
                        <li>L'accès se fait <strong>sur invitation</strong> : les inscriptions sont fermées pour le moment.</li>
                        <li>Des bugs peuvent encore se glisser, et les données publiées pendant la bêta pourraient être réinitialisées.</li>
                        <li>Tes retours sont précieux : <a href="mailto:hugo.noju9@gmail.com">hugo.noju9@gmail.com</a></li>
                    </ul>
                    <button type="button" class="btn btn--accent beta-notice__ok" data-close-dialog="beta-modal">J'ai compris</button>
                </div>
            </dialog>
        {% endif %}

        {# Pop-up À propos & Changelog #}
        <dialog id="about-modal" class="app-modal" aria-labelledby="about-title">
            <div class="modal-header">
                <h2 id="about-title">À propos du projet</h2>
                <button type="button" id="btn-close-about" class="modal-close-btn" aria-label="Fermer">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <section class="about-section">
                    <h3>Note d'intention</h3>
                    <p>
                        Cette application a été conçue comme un espace épuré de critique et de partage musical.
                        L'idée est de privilégier une expérience mobile-first réactive, permettant d'évaluer des albums,
                        de suivre l'évolution de ses avis grâce à un système de révisions, et de découvrir les retours de la communauté.
                    </p>
                </section>

                <hr class="modal-divider">

                <section class="about-section">
                    <h3>Changelog</h3>
                    <ul class="changelog-list">
                        <li>
                            <strong>v1.1.0 (12/11/2026) :</strong> pages Mentions légales, CGU et Politique de confidentialité,
                            suppression de son compte depuis « Modifier le profil », brouillon automatique des critiques
                            (plus de texte perdu en fermant la fenêtre), touche Entrée pour enregistrer la description du profil,
                            et message d'accueil de la bêta fermée.
                        </li>
                        <li>
                            <strong>v1.0.0 (08/11/2026) - bêta privée :</strong> première version en ligne.
                            Nouvelle direction artistique « bac à disques », notation par étoiles, profils personnalisables
                            (photo, description, statistiques), choix de la plateforme d'écoute, navigation complète au clavier,
                            protections anti-spam et renforcement de la sécurité. Inscriptions fermées : accès sur invitation.
                        </li>
                        <li><strong>v0.3 :</strong> Intégration du système de likes asynchrones et layout responsive Desktop.</li>
                        <li><strong>v0.2 :</strong> Ajout des modales AJAX (recherche Spotify, édition, révisions).</li>
                        <li><strong>v0.1 :</strong> Version initiale mobile (système de notation, cartes de critiques, profils).</li>
                    </ul>
                </section>
            </div>
        </dialog>

        {% block footer %}
            <footer class="site-footer">
                <div class="container site-footer__inner">
                    <nav class="site-footer__nav" aria-label="Informations">
                        <button type="button" id="btn-about-trigger" class="site-footer__link">À propos &amp; changelog</button>
                        <a href="{{ path('app_legal_notice') }}" class="site-footer__link">Mentions légales</a>
                        <a href="{{ path('app_terms') }}" class="site-footer__link">CGU</a>
                        <a href="{{ path('app_privacy') }}" class="site-footer__link">Confidentialité</a>
                    </nav>
                    <span>Album/List — conçu par Hugo Noblot</span>
                </div>
            </footer>
        {% endblock %}

        {% block javascripts %}
            <script src="{{ asset('js/app.js') }}" defer></script>
        {% endblock %}
    </body>
</html>

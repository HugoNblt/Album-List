<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
</head>

    {% block header %}
    <header>
        <h1>Album List</h1>
        <nav>
            <ul>
                <li><a href="{{ path('app_home') }}">Accueil</a></li>

                {% if app.user %}
                    <li><p>{{ app.user.userIdentifier }}</p> <a href="{{ path('app_logout') }}">Logout</a></li>
                {% else %}
                    <li><a href="{{ path('app_login') }}">Login/Register</a></li>
                {% endif %}
            </ul>
        </nav>
    </header>
    {% endblock %}

    {% block body %}
    {% endblock %}


        {%  block footer %}
            <footer style="position: absolute; bottom: 0;">@Designed By Hugo NOBLOT</footer>
        {% endblock %}
</html>

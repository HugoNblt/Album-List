<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>
            {% block title %}Album List
            {% endblock %}
        </title>
        {# <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">  #}
        {# <link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
> #}
        {% block stylesheets %}
            <link href="{{ asset('css/styles.css') }}" type="text/css" rel="stylesheet">
        {% endblock %}
        
    </head>
    <body>
        {% block header %}
            <header class="app-header">
    <div class="header-container">
        <nav class="top-nav">
            <ul class="top-nav-list">
                <li><a href="{{ path('app_home') }}" class="top-nav-link">Accueil</a></li>
                {% if app.user %}
                    <li><a href="{{ path('app_profile') }}" class="top-nav-link">Profil</a></li>
                    
                    {# Bouton qui déclenche la pop-up / modale #}
                    <li>
                        <button type="button" class="top-nav-link nav-btn-modal" id="open-new-review-modal">
                            + Nouvelle Review
                        </button>
                    </li>
                    
                    <li><span class="top-nav-user">{{ app.user.username }}</span></li>
                    <li><a href="{{ path('app_logout') }}" class="top-nav-link">Déconnexion</a></li>
                {% else %}
                    <li><a href="{{ path('app_login') }}" class="top-nav-link">Connexion</a></li>
                    <li><a href="{{ path('app_register') }}" class="top-nav-link">Inscription</a></li>
                {% endif %}
            </ul>
        </nav>
    </div>
</header>
        {% endblock %}

        <main>
            {% block body %}{% endblock %}
        </main>

        <!-- Modale unique native HTML5 -->
        <dialog id="review-modal" style="padding: 25px; border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.3); max-width: 650px; width: 95%;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h3 id="modal-title" style="margin:0;">Créer une review</h3>
                <button type="button" onclick="document.getElementById('review-modal').close()" style="background:none; border:none; font-size:1.2rem; cursor:pointer;">✕</button>
            </div>
            <div id="modal-body"></div>
        </dialog>

        {# Bouton fixe en bas à gauche #}
<button type="button" id="btn-about-trigger" class="floating-help-btn" aria-label="À propos">
    ?
</button>

{# Pop-up À propos & Changelog #}
<dialog id="about-modal" class="app-modal">
    <div class="modal-header">
        <h2>À propos du projet</h2>
        <button type="button" id="btn-close-about" class="modal-close-btn">&times;</button>
    </div>
    <div class="modal-body">
        <section class="about-section">
            <h3>🎯 Note d'intention</h3>
            <p>
                Cette application a été conçue comme un espace épuré de critique et de partage musical. 
                L'idée est de privilégier une expérience mobile-first réactive, permettant d'évaluer des albums, 
                de suivre l'évolution de ses avis grâce à un système de révisions, et de découvrir les retours de la communauté.
            </p>
        </section>

        <hr class="modal-divider">

        <section class="about-section">
            <h3>📜 Changelog</h3>
            <ul class="changelog-list">
                <li><strong>v1.2 :</strong> Intégration du système de likes asynchrones et layout responsive Desktop.</li>
                <li><strong>v1.1 :</strong> Ajout des modales AJAX (recherche Spotify, édition, révisions).</li>
                <li><strong>v1.0 :</strong> Version initiale mobile (système de notation, cartes de critiques, profils).</li>
            </ul>
        </section>
    </div>
</dialog>

        {% block footer %}
            <footer style="position: relative; bottom: 0;">@Designed By Hugo NOBLOT</footer>
        {% endblock %}

        {% block javascripts %}
            <script src="{{ asset('js/app.js') }}" defer></script>
        {% endblock %}
    </body>
</html>

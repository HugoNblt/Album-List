{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="register-container">
    <form method="post" class="register-card login-card">
        <h1>Connexion</h1>

        {% if error %}
            <div class="form-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="register-footer-link">
                Tu es connecté en tant que {{ app.user.userIdentifier }}. <a href="{{ logout_path() }}">Se déconnecter</a>
            </div>
        {% endif %}

        <label for="username">Email</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-input" autocomplete="email" required autofocus>
        <label for="password">Mot de passe</label>
        <input type="password" name="_password" id="password" class="form-input" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}

        <button class="btn-primary-submit" type="submit">
            Se connecter
        </button>

        <div class="register-footer-link">
            {% if registration_enabled %}
                Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a>
            {% else %}
                Bêta privée : l'accès se fait sur invitation.
            {% endif %}
        </div>
    </form>
</div>
{% endblock %}

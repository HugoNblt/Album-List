<div class="review-card">
    
    {# Header : Utilisateur & Date #}
    {% if review.user %}
        {% set authorName = review.user.username ?: review.user.userIdentifier %}
        <div class="user_info">
            <div class="user_info_pp">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
            </div>
            <div>
                <div class="user_info_name">{{ authorName }}</div>
                {% if review.createdAt %}
                    <div class="user_info_publish_date">Publié le {{ review.createdAt | date('d/m/Y') }}</div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {# Bloc Album & Note #}
    {% if review.album %}
        <div class="review_card_album">
            <img src="{{ review.album.coverImage | default('https://via.placeholder.com/130') }}" alt="Cover de {{ review.album.title }}" class="review_card_cover">
            
            <div class="review_card_details">
                <h3 class="review_card_title">{{ review.album.title }}</h3>
                <div class="review_card_artist">{{ review.album.artist }}</div>
                
                <div class="review_card_rating">
                    {{ review.rating }}/10
                </div>

                {# Affichage dynamique des étoiles #}
                <div class="review_card_stars">
                    {% set ratingOutOf5 = review.rating / 2 %}
                    {% for i in 1..5 %}
                        {% if ratingOutOf5 >= i %}
                            ★
                        {% elseif ratingOutOf5 >= (i - 0.5) %}
                            <span class="review_card_star_half">★</span>
                        {% else %}
                            <span class="review_card_star_empty">★</span>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}

    {# Contenu de la review #}
    <div class="review_card_content">
        {{ review.content }}
    </div>

    {# Footer & Actions #}
    <div class="review_card_footer">
        {# Bouton de Like #}
            {% set isLiked = app.user and review.isLikedByUser(app.user) %}
            <button 
                type="button" 
                class="like-btn {{ isLiked ? 'is-liked' : '' }}" 
                data-url="{{ path('app_review_like', { id: review.id }) }}">
                
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" 
                     fill="{{ isLiked ? '#e63946' : 'none' }}" 
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="heart-icon">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
                
                <span class="like-count">{{ review.likes|length }}</span>
            </button>
        
        {# Actions de l'auteur, Historique & Like #}
        <div class="review_card_actions">
            {% if app.user and review.user == app.user %}
                <button type="button" class="btn-choose-album" data-spotify-id="{{ review.album ? review.album.spotifyId : '' }}">
                    + Nouvelle révision
                </button>

                <button type="button" class="btn-edit-review" data-id="{{ review.id }}">
                    Modifier
                </button>

                <form action="{{ path('app_post_delete', {id: review.id}) }}" method="post" onsubmit="return confirm('Supprimer cette critique ?');" class="review_card_delete_form">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
                    <button type="submit" class="btn-delete-review">
                        Supprimer
                    </button>
                </form>
            {% endif %}

            {# Calcul sécurisé de l'historique #}
            {% set userReviewsCount = 0 %}
            {% if review.album and attribute(review.album, 'reviews') is defined and review.album.reviews is not empty %}
                {% set userReviewsCount = review.album.reviews | filter(r => r.user and review.user and r.user.id == review.user.id) | length %}
            {% endif %}

            {% if userReviewsCount > 1 %}
                <button type="button" class="btn-history-review" data-id="{{ review.id }}">
                    📜 Historique ({{ userReviewsCount }})
                </button>
            {% endif %}
        </div>

        {# Bouton d'écoute universel #}
        {% if review.album and review.album.spotifyId %}
            <a href="https://open.spotify.com/album/{{ review.album.spotifyId }}" target="_blank" rel="noopener noreferrer" class="review_card_btn_listen">
                <span class="review_card_btn_listen_icon">▶</span> Écouter
            </a>
        {% endif %}

    </div>
</div>
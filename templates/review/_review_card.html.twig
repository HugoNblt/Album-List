<div class="review-card" style="display: flex; gap: 15px; border: 1px solid #ddd; padding: 15px; border-radius: 8px; margin-bottom: 15px; align-items: flex-start; background: #fff;">
	{% if review.album %}
		<img src="{{ review.album.coverImage | default('https://via.placeholder.com/100') }}" alt="Cover de {{ review.album.title }}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px; flex-shrink: 0;">
	{% endif %}

	<div style="flex: 1;">
		<div style="display: flex; justify-content: space-between; align-items: flex-start;">
			<div>
				{% if review.album %}
					<h4 style="margin: 0 0 3px 0;">
						{{ review.album.title }}
						<small style="font-weight: normal; color: #555;">par
							{{ review.album.artist }}</small>
					</h4>
				{% endif %}
				{% if review.user %}
					{% set authorName = review.user.username ?: review.user.userIdentifier %}
					<small style="color: #007bff; font-weight: bold;">Par
						{{ authorName }}</small>
				{% endif %}
			</div>
			{% if review.createdAt %}
				<small style="color: #666; font-size: 0.8rem;">Publié le
					{{ review.createdAt | date('d/m/Y') }}</small>
			{% endif %}
		</div>

		<p style="margin: 8px 0; font-size: 0.95rem;">
			<strong>Note :</strong>
			{{ review.rating }}/10</p>
		<p style="margin: 0 0 12px 0; color: #333; white-space: pre-line;">{{ review.content }}</p>

		<div
			style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
			{# Bouton d'écoute universel #}
			{% if review.album and review.album.spotifyId %}
				<a href="https://song.link/s/{{ review.album.spotifyId }}" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 5px; background: #111; color: #fff; padding: 5px 12px; border-radius: 4px; font-size: 0.85rem; text-decoration: none; font-weight: bold;">
					🎧 Écouter l'album
				</a>
			{% endif %}

			{# Actions réservées à l'auteur #}
			{% if app.user and review.user == app.user %}
				<button type="button" class="btn-choose-album" data-spotify-id="{{ review.album.spotifyId }}" style="background: #1DB954; color: white; padding: 5px 12px; border: none; border-radius: 4px; font-size: 0.85rem; cursor: pointer;">
					+ Nouvelle révision
				</button>

				<button type="button" class="btn-edit-review" data-id="{{ review.id }}" style="background: #333; color: white; padding: 5px 12px; border: none; border-radius: 4px; font-size: 0.85rem; cursor: pointer;">
					Modifier
				</button>

				<form action="{{ path('app_post_delete', {id: review.id}) }}" method="post" onsubmit="return confirm('Supprimer cette critique ?');" style="display:inline;">
					<input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
					<button type="submit" style="background: #e74c3c; color: white; padding: 5px 12px; border: none; border-radius: 4px; font-size: 0.85rem; cursor: pointer;">
						Supprimer
					</button>
				</form>
			{% endif %}

{# Calcul sécurisé de l'historique #}
{% set userReviewsCount = 0 %}
{% if review.album and attribute(review.album, 'reviews') is defined and review.album.reviews is not empty %}
    {% set userReviewsCount = review.album.reviews | filter(r => r.user and review.user and r.user.id == review.user.id) | length %}
{% endif %}

{% if userReviewsCount > 1 %}
    <button type="button" class="btn-history-review" data-id="{{ review.id }}" style="background: #f0f0f0; color: #333; border: 1px solid #ccc; padding: 5px 12px; border-radius: 4px; font-size: 0.85rem; cursor: pointer;">
        📜 Historique ({{ userReviewsCount }})
    </button>
{% endif %}
		</div>
	</div>
</div>

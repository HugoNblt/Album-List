{% extends 'base.html.twig' %}

{% block title %}
	Accueil - Fil d'actualité
{% endblock %}

{% block body %}
	<div class="home-page">
		{# Barre de recherche #}
		<div class="home-intro">
			<h1 class="home-title">Découvrez & Partagez de la Musique</h1>
			<form action="{{ path('app_home') }}" method="get" class="home-search-form">
				<input type="search" class="main_searchbar" name="q" value="{{ q|default('') }}" placeholder="Rechercher un album, un artiste ou un profil...">
				<button type="submit" class="home-search-button">Rechercher</button>
				{% if query %}
					<a href="{{ path('app_home') }}" class="home-search-reset">
						Réinitialiser
					</a>
				{% endif %}
			</form>
		</div>

		{# SECTION : Résultats de la recherche Utilisateurs #}
		{% if users is defined and users is not empty %}
			<h2 class="home-section-title home-users-title">Profils trouvés ({{ users|length }})</h2>
			<div class="home-user-list">
				{% for u in users %}
					{% if u.username is not empty %}
						<a href="{{ path('app_profile_show', { username: u.username }) }}" class="home-user-link">
							<span class="home-user-avatar">
								{{ u.username|first|upper }}
							</span>
							{{ u.username }}
						</a>
					{% endif %}
				{% endfor %}
			</div>
		{% endif %}

		{# SECTION : Critiques (Fil principal ou Résultats) #}
		<section class="home-reviews-section">
			{% if query %}
				<h2 class="home-section-title">Critiques trouvées ({{ reviews|length }})</h2>
			{% else %}
				<h2 class="home-section-title">Dernières critiques de la communauté</h2>
			{% endif %}

			{% if reviews is empty %}
				<div class="home-empty-state">
					<p>Aucune critique trouvée pour "{{ query }}".</p>
				</div>
			{% else %}
				<div class="reviews-grid">
					{% for review in reviews %}
						{% include 'review/_review_card.html.twig' with {'review': review} %}
					{% endfor %}
				</div>
			{% endif %}
		</section>

	</div>
{% endblock %}

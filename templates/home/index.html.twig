{% extends 'base.html.twig' %}

{% block title %}Accueil - Fil d'actualité
{% endblock %}

{% block body %}
	<div
		style="max-width: 900px; margin: 0 auto; padding: 20px;">

		{# Header & Barre de recherche #}
		<div style="text-align: center; margin-bottom: 30px;">
			<h1>🎵 Découvrez & Partagez de la Musique</h1>

			<form action="{{ path('app_home') }}" method="get" style="margin-top: 20px; display: flex; gap: 10px; justify-content: center;">
				<input type="text" name="q" value="{{ query }}" placeholder="Rechercher un album, un artiste ou un profil..." style="width: 70%; max-width: 500px; padding: 12px 16px; border-radius: 25px; border: 1px solid #ccc; font-size: 1rem;">
				<button type="submit" style="padding: 12px 20px; background: #1DB954; color: white; border: none; border-radius: 25px; font-weight: bold; cursor: pointer;">
					🔍 Rechercher
				</button>
				{% if query %}
					<a href="{{ path('app_home') }}" style="padding: 12px 16px; background: #eee; color: #333; border-radius: 25px; text-decoration: none; font-size: 0.9rem; align-self: center;">
						Réinitialiser
					</a>
				{% endif %}
			</form>
		</div>

		{# SECTION : Résultats de la recherche Utilisateurs #}
		{% if query and users is not empty %}
			<section style="margin-bottom: 40px;">
				<h2>👤 Profils trouvés ({{ users|length }})</h2>
				<div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px;">
					{% for user in users %}
						{% set displayName = user.username ?: user.userIdentifier %}
						<a href="{{ path('app_profile_show', {id: user.id}) }}" style="text-decoration: none; color: inherit;">
							<div style="display: flex; align-items: center; gap: 10px; background: #f9f9f9; padding: 10px 16px; border-radius: 20px; border: 1px solid #e0e0e0;">
								<div style="width: 35px; height: 35px; border-radius: 50%; background: #007bff; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">
									{{ displayName|slice(0, 1)|upper }}
								</div>
								<span style="font-weight: bold;">{{ displayName }}</span>
							</div>
						</a>
					{% endfor %}
				</div>
			</section>
		{% endif %}

		{# SECTION : Critiques (Fil principal ou Résultats) #}
		<section>
			{% if query %}
				<h2>📀 Critiques trouvées ({{ reviews|length }})</h2>
			{% else %}
				<h2>🔥 Dernières critiques de la communauté</h2>
			{% endif %}

			{% if reviews is empty %}
				<div style="background: #f8f9fa; padding: 20px; border-radius: 8px; text-align: center; margin-top: 20px;">
					<p style="color: #666;">Aucune critique trouvée pour "{{ query }}".</p>
				</div>
			{% else %}
				<div style="display: flex; flex-direction: column; gap: 20px; margin-top: 20px;">
					{% for review in reviews %}
						{% include 'review/_review_card.html.twig' with {'review': review} %}
					{% endfor %}
				</div>
			{% endif %}
		</section>

	</div>
{% endblock %}

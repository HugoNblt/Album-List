{% extends 'base.html.twig' %}

{% block title %}Accueil - Fil d'actualité
{% endblock %}

{% block body %}
	<div
		style="max-width: 900px; margin: 0 auto; padding: 20px;">

		{# Header & Barre de recherche #}
		<div style="text-align: center; margin-bottom: 30px;">
			<h1>🎵 Découvrez & Partagez de la Musique</h1>

			<form action="{{ path('app_home') }}" method="get" style="margin-top: 20px; display: flex; gap: 10px; justify-content: center;">
<input type="search" name="q" value="{{ q|default('') }}" placeholder="Rechercher un album, un artiste ou un profil...">				<button type="submit" style="padding: 12px 20px; background: #1DB954; color: white; border: none; border-radius: 25px; font-weight: bold; cursor: pointer;">
					🔍 Rechercher
				</button>
				{% if query %}
					<a href="{{ path('app_home') }}" style="padding: 12px 16px; background: #eee; color: #333; border-radius: 25px; text-decoration: none; font-size: 0.9rem; align-self: center;">
						Réinitialiser
					</a>
				{% endif %}
			</form>
		</div>

		{# SECTION : Résultats de la recherche Utilisateurs #}
		{# Section Profils trouvés dans templates/home/index.html.twig #}
{% if users is defined and users is not empty %}
    <h2 style="margin-top: 30px;">🟣 Profils trouvés ({{ users|length }})</h2>
    <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 30px;">
        {% for u in users %}
            {% if u.username is not empty %}
                <a href="{{ path('app_profile_show', { username: u.username }) }}" style="padding: 10px 18px; background: #fff; color: #000; border-radius: 20px; text-decoration: none; font-weight: bold; display: inline-flex; align-items: center; gap: 8px;">
                    <span style="width: 24px; height: 24px; background: #007bff; color: #fff; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem;">
                        {{ u.username|first|upper }}
                    </span>
                    {{ u.username }}
                </a>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}

		{# SECTION : Critiques (Fil principal ou Résultats) #}
		<section>
			{% if query %}
				<h2>📀 Critiques trouvées ({{ reviews|length }})</h2>
			{% else %}
				<h2>🔥 Dernières critiques de la communauté</h2>
			{% endif %}

			{% if reviews is empty %}
				<div style="background: #f8f9fa; padding: 20px; border-radius: 8px; text-align: center; margin-top: 20px;">
					<p style="color: #666;">Aucune critique trouvée pour "{{ query }}".</p>
				</div>
			{% else %}
				<div style="display: flex; flex-direction: column; gap: 20px; margin-top: 20px;">
					{% for review in reviews %}
						{% include 'review/_review_card.html.twig' with {'review': review} %}
					{% endfor %}
				</div>
			{% endif %}
		</section>

	</div>
{% endblock %}

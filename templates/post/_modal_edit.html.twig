<div style="display: flex; gap: 20px; align-items: flex-start;">
    <div style="width: 120px; flex-shrink: 0;">
        {% if review.album %}
            <img src="{{ review.album.coverImage }}" alt="Cover" style="width: 100%; border-radius: 6px;">
            <h4 style="font-size: 0.9rem; margin: 8px 0 2px 0;">{{ review.album.title }}</h4>
            <p style="font-size: 0.8rem; color: #555; margin: 0;">{{ review.album.artist }}</p>
        {% endif %}
    </div>
    <div style="flex: 1;">
        {{ form_start(form, { 'attr': { 'id': 'modal-edit-form' } }) }}
            {{ form_row(form.rating) }}
            {{ form_row(form.content) }}
            <div style="display: flex; gap: 10px; margin-top: 15px;">
                <button type="submit" style="background: #1DB954; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">Enregistrer</button>
                <button type="button" onclick="document.getElementById('review-modal').close()" style="background: #ccc; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">Annuler</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
<div class="history-header">
    <img src="{{ album.coverImage }}" alt="Cover" class="history-cover">
    <div>
        <h4 class="modal-album-title">{{ album.title }}</h4>
        <p class="modal-album-artist">par {{ album.artist }}</p>
        <small class="history-meta">Historique de <strong>{{ reviewUser.userIdentifier }}</strong> ({{ reviews|length }} révision{% if reviews|length > 1 %}s{% endif %})</small>
    </div>
</div>

<div class="history-list">
    {% for r in reviews %}
        <div class="history-item {{ loop.first ? 'is-latest' : '' }}">
            <div class="history-item-header">
                <span class="history-item-rating">
                    Note : {{ r.rating }}/10
                    {% if loop.first %}
                        <small class="history-badge">Dernière révision</small>
                    {% endif %}
                </span>
                <small class="history-item-date">Publié le {{ r.createdAt | date('d/m/Y à H:i') }}</small>
            </div>
            <p class="history-item-content">{{ r.content }}</p>
        </div>
    {% endfor %}
</div>

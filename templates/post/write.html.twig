{% extends 'base.html.twig' %}

{% block title %}Rédiger une critique{% endblock %}

{% block body %}
<div class="container">
    <h1>Critique de {{ album.title }}</h1>
    
    <div style="display: flex; gap: 30px; margin-top: 20px;">
        <div style="width: 250px;">
            <img src="{{ album.coverImage }}" alt="Cover" style="width: 100%; border-radius: 8px;">
            <h3>{{ album.artist }}</h3>
            <p>{{ album.releaseYear }}</p>
        </div>
        
        <div style="flex: 1;">
            {{ form_start(form) }}
                {{ form_row(form.rating) }}
                {{ form_row(form.content) }}
                <button type="submit" style="margin-top: 15px; padding: 10px 20px;">Publier ma critique</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
{# Formulaire commun écriture / édition. Paramètres : form, album, formId, submitLabel, secondary ('back' | 'cancel') #}
<div class="modal-album">
    {% if album %}
        <img src="{{ album.coverImage }}" alt="Pochette de {{ album.title }}" class="cover">
        <div>
            {% if album.releaseYear %}
                <p class="eyebrow">{{ album.releaseYear }} · Album</p>
            {% endif %}
            <h4 class="modal-album-title">{{ album.title }}</h4>
            <p class="modal-album-artist">{{ album.artist }}</p>
        </div>
    {% endif %}
</div>

{{ form_start(form, { attr: { id: formId, novalidate: 'novalidate' } }) }}
    {# Note : sélecteur d'étoiles qui alimente le champ caché « rating » #}
    <fieldset class="rating-field star-field">
        <legend class="eyebrow">Ta note — moitié gauche d'une étoile = demi-étoile</legend>
        <div class="rating-display" aria-live="polite">
            <span class="rating-display__value">{{ form.rating.vars.value ?: '–' }}</span>
            <span class="rating-display__max">/10</span>
            <span class="rating-display__verdict"></span>
        </div>
        <div class="star-picker">
            {% for i in 1..5 %}
                <span class="star">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7.3L12 17.8 5.7 21.5l1.7-7.3L2 9.5l7.1-.6z"/></svg>
                    <span class="star__fill"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7.3L12 17.8 5.7 21.5l1.7-7.3L2 9.5l7.1-.6z"/></svg></span>
                    <button type="button" class="star-picker__half star-picker__half--low" data-value="{{ i * 2 - 1 }}" aria-label="Note {{ i * 2 - 1 }} sur 10"></button>
                    <button type="button" class="star-picker__half star-picker__half--high" data-value="{{ i * 2 }}" aria-label="Note {{ i * 2 }} sur 10"></button>
                </span>
            {% endfor %}
        </div>
        {{ form_widget(form.rating, { type: 'hidden', attr: { class: 'rating-input' } }) }}
        <div class="form-errors">{{ form_errors(form.rating) }}</div>
    </fieldset>

    <div class="modal-field">
        {{ form_label(form.content, 'Ta critique', { label_attr: { class: 'eyebrow' } }) }}
        {{ form_widget(form.content, { attr: { placeholder: "Ce qui t'a marqué, ce qui t'a déçu…" } }) }}
        {{ form_errors(form.content) }}
    </div>

    <div class="modal-actions">
        {% if secondary == 'back' %}
            <button type="button" id="btn-back-search" class="btn">← Retour</button>
        {% else %}
            <button type="button" class="btn" onclick="document.getElementById('review-modal').close()">Annuler</button>
        {% endif %}
        <button type="submit" class="btn btn--accent">{{ submitLabel }}</button>
    </div>
{{ form_end(form) }}

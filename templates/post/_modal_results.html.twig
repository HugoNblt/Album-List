<form id="modal-search-form" method="get" class="modal-search-form">
    <input type="search" name="q" value="{{ query }}" placeholder="Rechercher..." required class="search-input">
    <button type="submit" class="search-btn">Chercher</button>
</form>

<div class="modal-results">
    {% for album in albums %}
        <div class="modal-result">
            <img src="{{ album.images[2].url | default('https://via.placeholder.com/50') }}" alt="" class="modal-result-cover">
            <div class="modal-result-info">
                <strong>{{ album.name }}</strong>
                <small>{{ album.artists[0].name }}</small>
            </div>
            <button type="button" class="btn-choose-album btn-choose-album--primary" data-spotify-id="{{ album.id }}">
                Choisir
            </button>
        </div>
    {% else %}
        <p class="modal-empty">Aucun résultat pour "{{ query }}".</p>
    {% endfor %}
</div>

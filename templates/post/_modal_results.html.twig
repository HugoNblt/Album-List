<form id="modal-search-form" method="get" style="margin-bottom: 15px;">
    <input type="text" name="q" value="{{ query }}" placeholder="Rechercher..." required style="padding: 6px; width: 65%;">
    <button type="submit" style="padding: 6px;">Chercher</button>
</form>

<div style="max-height: 350px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px;">
    {% for album in albums %}
        <div style="display: flex; align-items: center; gap: 15px; border: 1px solid #ddd; padding: 10px; border-radius: 6px;">
            <img src="{{ album.images[2].url | default('https://via.placeholder.com/50') }}" style="width: 50px; height: 50px; border-radius: 4px; object-fit: cover;">
            <div style="flex: 1;">
                <strong>{{ album.name }}</strong><br>
                <small>{{ album.artists[0].name }}</small>
            </div>
            <button type="button" class="btn-choose-album" data-spotify-id="{{ album.id }}" style="background: #1DB954; color: white; padding: 6px 12px; border: none; border-radius: 4px; font-size: 0.9rem; cursor: pointer;">
                Choisir
            </button>
        </div>
    {% else %}
        <p>Aucun résultat pour "{{ query }}".</p>
    {% endfor %}
</div>
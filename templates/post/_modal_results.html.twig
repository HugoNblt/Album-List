<form id="modal-search-form" method="get" class="search-block modal-search-form" role="search">
    <div class="search-block__field">
        <label for="modal-q" class="eyebrow">Chercher un album sur Spotify</label>
        <input type="search" id="modal-q" name="q" value="{{ query }}" placeholder="ex. Daft Punk" required class="search-block__input">
    </div>
    <div class="search-block__actions">
        <button type="submit" class="btn btn--accent">Chercher →</button>
    </div>
</form>

<div class="modal-results">
    {% for album in albums %}
        <div class="modal-result">
            <img src="{{ album.images[2].url | default('https://via.placeholder.com/50') }}" alt="" class="cover">
            <div class="modal-result-info">
                <strong>{{ album.name }}</strong>
                <small>{{ album.artists[0].name }}</small>
            </div>
            <button type="button" class="btn btn--accent btn-choose-album" data-spotify-id="{{ album.id }}">Choisir</button>
        </div>
    {% else %}
        <p class="modal-empty">Aucun résultat pour « {{ query }} ».</p>
    {% endfor %}
</div>

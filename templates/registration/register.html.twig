{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div style="max-width: 450px; margin: 40px auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px; background: #fff;">
    <h1 style="margin-top: 0;">Inscription</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.username) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe'
        }) }}

        <button type="submit" style="width: 100%; margin-top: 15px; padding: 10px; background: #1DB954; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">
            S'inscrire
        </button>
    {{ form_end(registrationForm) }}
</div>
{% endblock %}
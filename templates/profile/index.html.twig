{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.username }}{% endblock %}

{% block body %}
    <div class="container" style="max-width: 900px; margin: 40px auto; padding: 0 20px;">
        <h1 style="margin-bottom: 20px;">Dernières critiques d'album par {{ user.username }}</h1>

        {# Formulaire de recherche interne au profil #}
        <form method="GET" action="{{ path('app_profile_show', { username: user.username }) }}" style="display: flex; gap: 10px; margin-bottom: 30px;">
            <input 
                type="search" 
                name="q" 
                value="{{ q|default('') }}" 
                placeholder="Rechercher dans les avis de {{ user.username }}..." 
                style="flex: 1; padding: 12px 15px; border: 1px solid #444; background: #181818; color: #fff; border-radius: 6px; font-size: 1rem;"
            >
            <button type="submit" style="padding: 12px 20px; background: #1DB954; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">
                Rechercher
            </button>
            {% if q is defined and q is not empty %}
                <a href="{{ path('app_profile_show', { username: user.username }) }}" style="padding: 12px 18px; background: #444; color: white; text-decoration: none; border-radius: 6px; display: inline-flex; align-items: center; font-size: 0.9rem;">
                    Réinitialiser
                </a>
            {% endif %}
        </form>

        {# Liste des critiques #}
        <div class="reviews-feed" style="display: flex; flex-direction: column; gap: 20px;">
            {% for review in reviews %}
                {% include 'review/_review_card.html.twig' with { review: review } %}
            {% else %}
                <div style="text-align: center; padding: 40px; background: #181818; border-radius: 8px; color: #b3b3b3;">
                    {% if q is defined and q is not empty %}
                        <p style="margin: 0;">Aucune critique ne correspond à « {{ q }} » pour ce profil.</p>
                    {% else %}
                        <p style="margin: 0;">Aucune critique rédigée pour le moment.</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.username }}{% endblock %}

{% block body %}
    <div class="container page">
        {% set isOwner = app.user and app.user.id == user.id %}

        {# En-tête du profil : photo, description & statistiques #}
        <section class="profile-hero">
            {% if user.avatar %}
                <img src="{{ asset('uploads/avatars/' ~ user.avatar) }}" alt="Photo de profil de {{ user.username }}" class="avatar profile-hero__avatar">
            {% else %}
                <div class="avatar profile-hero__avatar" aria-hidden="true">{{ user.username|first|upper }}</div>
            {% endif %}

            <div class="profile-hero__main">
                <p class="eyebrow">Discothèque de</p>
                <h1 class="profile-hero__name">{{ user.username }}</h1>
            </div>

            {% if user.bio %}
                <p class="profile-hero__bio">{{ user.bio }}</p>
            {% endif %}

            <div class="profile-hero__side">
                <dl class="profile-stats">
                    <div>
                        <dt class="eyebrow">Album{{ stats.albums > 1 ? 's' }}</dt>
                        <dd>{{ '%02d'|format(stats.albums) }}</dd>
                    </div>
                    <div>
                        <dt class="eyebrow">Artiste{{ stats.artists > 1 ? 's' }}</dt>
                        <dd>{{ '%02d'|format(stats.artists) }}</dd>
                    </div>
                </dl>
                {% if isOwner %}
                    <a href="{{ path('app_profile_edit') }}" class="btn">Modifier le profil</a>
                {% endif %}
            </div>
        </section>

        {# Formulaire de recherche interne au profil #}
        <form method="GET" action="{{ path('app_profile_show', { username: user.username }) }}" class="search-block profile-search" role="search">
            <div class="search-block__field">
                <label for="profile-q" class="eyebrow">Chercher dans les critiques de {{ user.username }}</label>
                <input type="search" id="profile-q" name="q" value="{{ q|default('') }}" placeholder="titre, artiste, mot-clé" class="search-block__input">
            </div>
            <div class="search-block__actions">
                <button type="submit" class="btn btn--accent">Chercher →</button>
                {% if q is defined and q is not empty %}
                    <a href="{{ path('app_profile_show', { username: user.username }) }}" class="btn">Réinitialiser</a>
                {% endif %}
            </div>
        </form>

        {# Discographie : uniquement la dernière révision par album #}
        {% set displayedAlbums = [] %}
        {% set rows = [] %}
        {% for review in reviews %}
            {% if review.album and review.album.id not in displayedAlbums %}
                {% set displayedAlbums = displayedAlbums|merge([review.album.id]) %}
                {% set rows = rows|merge([review]) %}
            {% endif %}
        {% endfor %}

        {% if rows is empty %}
            <div class="empty-state">
                {% if q is defined and q is not empty %}
                    <p>Aucune critique ne correspond à « {{ q }} » pour ce profil.</p>
                {% else %}
                    <p>Aucune critique rédigée pour le moment.</p>
                {% endif %}
            </div>
        {% else %}
            <ol class="disc-list">
                {% for review in rows %}
                    {% set revisionCount = review.album.reviews|filter(r => r.user and r.user.id == user.id)|length %}
                    <li class="disc-row">
                        <span class="disc-row__no">N°{{ '%03d'|format(rows|length - loop.index0) }}</span>
                        <img src="{{ review.album.coverImage|default('https://via.placeholder.com/300') }}" alt="Pochette de {{ review.album.title }}" class="cover" loading="lazy">
                        <div class="disc-row__info">
                            <h2 class="disc-row__title">{{ review.album.title }}</h2>
                            <p class="disc-row__artist">{{ review.album.artist }}</p>
                            <p class="disc-row__date">{{ review.createdAt|date('d/m/Y') }}</p>
                        </div>
                        <div class="disc-row__rating">
                            <strong>{{ review.rating }}</strong>
                            {% include 'review/_stars.html.twig' with { rating: review.rating, size: 'lg' } only %}
                        </div>
                        <div class="disc-row__actions">
                            <div class="disc-row__bar">
                            {% set isLiked = app.user and review.isLikedByUser(app.user) %}
                            <button type="button" class="like-btn {{ isLiked ? 'is-liked' }}" data-url="{{ path('app_review_like', { id: review.id }) }}" aria-label="J'aime">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="{{ isLiked ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="heart-icon" aria-hidden="true">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                                <span class="like-count">{{ review.likes|length }}</span>
                            </button>
                            {% if revisionCount > 1 %}
                                <button type="button" class="history-link btn-history-review" data-id="{{ review.id }}">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5M12 7v5l3 2"/></svg>
                                    Historique · {{ revisionCount }}
                                </button>
                            {% endif %}
                            {% if review.album.spotifyId %}
                                <a href="https://open.spotify.com/album/{{ review.album.spotifyId }}" target="_blank" rel="noopener noreferrer" class="btn btn--accent btn-listen">▶ Écouter</a>
                            {% endif %}
                            </div>
                            {% if isOwner %}
                                <div class="owner-actions">
                                    <button type="button" class="owner-action btn-choose-album" data-spotify-id="{{ review.album.spotifyId }}">+ Révision</button>
                                    <button type="button" class="owner-action btn-edit-review" data-id="{{ review.id }}">Modifier</button>
                                    <form action="{{ path('app_post_delete', {id: review.id}) }}" method="post" onsubmit="return confirm('Supprimer cette critique ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
                                        <button type="submit" class="owner-action owner-action--danger">Supprimer</button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="container">
    <h1>Profil de {{ user.email }}</h1>
    
    <h2>Mes derniers ajouts de reviews d'album</h2>
    
    <div style="display: flex; flex-wrap: wrap; gap: 20px;">
        {% for review in reviews %}
            {# Début d'une carte #}
            <div class="review-card" style="display: flex; gap: 15px; border: 1px solid #ddd; padding: 15px; border-radius: 8px; margin-bottom: 15px; align-items: flex-start; background: #fff;">
    {% if review.album %}
        <img src="{{ review.album.coverImage | default('https://via.placeholder.com/100') }}" alt="Cover de {{ review.album.title }}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px; flex-shrink: 0;">
    {% endif %}
    
    <div style="flex: 1;">
        {% if review.album %}
            <h4 style="margin: 0 0 5px 0;">{{ review.album.title }} <small style="font-weight: normal; color: #555;">par {{ review.album.artist }}</small></h4>
        {% endif %}
        <p style="margin: 0 0 8px 0;"><strong>Note :</strong> {{ review.rating }}/10</p>
        <p style="margin: 0; color: #333;">{{ review.content }}</p>

        {% if app.user and review.user == app.user %}
            <div style="display: flex; gap: 10px; margin-top: 12px;">
                <button type="button" class="btn-edit-review" data-id="{{ review.id }}" style="background: #333; color: white; padding: 5px 12px; border: none; border-radius: 4px; font-size: 0.85rem; cursor: pointer;">
                    Modifier
                </button>
                <form action="{{ path('app_post_delete', {id: review.id}) }}" method="post" onsubmit="return confirm('Supprimer cette critique ?');" style="display:inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
                    <button type="submit" style="background: #e74c3c; color: white; padding: 5px 12px; border: none; border-radius: 4px; font-size: 0.85rem; cursor: pointer;">
                        Supprimer
                    </button>
                </form>
            </div>
        {% endif %}
    </div>
</div>
        {% else %}
            <p>Tu n'as posté aucun avis pour le moment.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
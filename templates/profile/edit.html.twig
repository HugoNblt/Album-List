{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<div class="register-container">
    <div class="register-card profile-edit-card">
        <h1>Modifier mon profil</h1>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            {# Photo de profil #}
            <div class="form-group">
                <div class="profile-edit-avatar">
                    {% if app.user.avatar %}
                        <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="Photo de profil actuelle" class="avatar">
                    {% else %}
                        <div class="avatar">{{ app.user.username|first|upper }}</div>
                    {% endif %}
                    <div class="profile-edit-avatar-fields">
                        {{ form_label(form.avatarFile) }}
                        {{ form_widget(form.avatarFile) }}
                        {% if app.user.avatar %}
                            <label class="profile-edit-checkbox">
                                {{ form_widget(form.removeAvatar) }}
                                {{ form.removeAvatar.vars.label }}
                            </label>
                        {% else %}
                            {% do form.removeAvatar.setRendered %}
                        {% endif %}
                    </div>
                </div>
                {% for error in form.avatarFile.vars.errors %}
                    <div class="form-error">{{ error.message }}</div>
                {% endfor %}
            </div>

            {# Pseudo #}
            <div class="form-group">
                {{ form_label(form.username) }}
                {{ form_widget(form.username) }}
                {% for error in form.username.vars.errors %}
                    <div class="form-error">{{ error.message }}</div>
                {% endfor %}
            </div>

            {# Description #}
            <div class="form-group">
                {{ form_label(form.bio) }}
                {{ form_widget(form.bio) }}
                <p class="form-hint" id="bio-hint">Entrée pour enregistrer, Maj + Entrée pour aller à la ligne.</p>
                {% for error in form.bio.vars.errors %}
                    <div class="form-error">{{ error.message }}</div>
                {% endfor %}
            </div>

            <button type="submit" class="btn-primary-submit">Enregistrer</button>

        {{ form_end(form) }}

        <div class="register-footer-link">
            <a href="{{ path('app_profile') }}">Retour au profil</a>
        </div>

        {# Zone sensible : suppression définitive du compte #}
        <section class="danger-zone" aria-labelledby="danger-zone-title">
            <h2 id="danger-zone-title" class="danger-zone__title">Supprimer mon compte</h2>
            <p class="danger-zone__text">
                Ton compte, ta photo de profil et
                {% if reviewCount > 0 %}
                    <strong>tes {{ reviewCount }} critique{{ reviewCount > 1 ? 's' }} (révisions comprises)</strong>
                {% else %}
                    tes critiques
                {% endif %}
                seront supprimés définitivement. Cette action est irréversible.
            </p>
            <form action="{{ path('app_profile_delete') }}" method="post"
                  data-confirm="Supprimer définitivement ton compte{{ reviewCount > 0 ? ' et tes ' ~ reviewCount ~ ' critique' ~ (reviewCount > 1 ? 's' : '') }} ? Cette action est irréversible.">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
                <div class="form-group">
                    <label for="delete-password">Confirme avec ton mot de passe</label>
                    <input type="password" id="delete-password" name="password" class="form-input" autocomplete="current-password" required>
                </div>
                <button type="submit" class="btn btn--danger danger-zone__submit">Supprimer mon compte</button>
            </form>
        </section>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% set displayName = profileUser.username ?: profileUser.userIdentifier %}

{% block title %}Profil de {{ displayName }}{% endblock %}

{% block body %}
<div class="page-container">
    {# En-tête du profil #}
    <div class="profile-header">
        <div class="profile-avatar">
            {{ displayName|slice(0, 1)|upper }}
        </div>
        <div>
            <h1 class="profile-name">{{ displayName }}</h1>
            <p class="profile-subtitle">Membre de la communauté</p>
        </div>
    </div>

    <h2 class="home-section-title">Critiques de {{ displayName }}</h2>

    {# Fil d'actualité de l'utilisateur (uniquement la dernière révision par album) #}
    {% set displayedAlbums = [] %}
    <div class="reviews-grid">
        {% for review in reviews %}
            {% if review.album and review.album.id not in displayedAlbums %}
                {% set displayedAlbums = displayedAlbums | merge([review.album.id]) %}
                {% include 'review/_review_card.html.twig' with {'review': review} %}
            {% endif %}
        {% else %}
            <p class="home-empty-state">Cet utilisateur n'a pas encore rédigé de critique.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}